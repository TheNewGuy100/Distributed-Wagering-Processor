{
  "name": "distributed-wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down -v",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "test": "bun test",
    "test:unit": "bun test src",
    "test:integration": "bun test test/integration --timeout 90000",
    "test:concurrency": "bun scripts/test-concurrency.ts",
    "test:load": "bun scripts/load-test.ts",
    "ci": "bun run typecheck && bun run test:unit && bun run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1163.0",
    "@mikro-orm/core": "^7.2.7",
    "@mikro-orm/migrations": "^7.2.7",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.7",
    "@nestjs/common": "^12.3.3",
    "@nestjs/config": "^12.1.0",
    "@nestjs/core": "^12.3.3",
    "@nestjs/platform-express": "^12.3.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.7",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  }
}
