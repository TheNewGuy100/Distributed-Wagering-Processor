PORT=3000
DATABASE_URL=postgresql://wagering:wagering@localhost:5432/wagering
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo

# Authentication (off by default). With AUTH_MODE=jwt both AUTH_ISSUER and AUTH_AUDIENCE are required.
# See README.md ("Authentication") and docker-compose.yml (Keycloak is part of the stack).
AUTH_MODE=none
# AUTH_ISSUER=https://keycloak.example.com/realms/wagering
# AUTH_AUDIENCE=wagering-api
# AUTH_JWKS_URI=
# AUTH_PROVIDER_CLAIM=provider_id
